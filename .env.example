GOOGLE_API_KEY=your_api_key_here 
# Generate a random secret of at least 32 bytes before enabling LMS authentication.
LECTURESEEK_JWT_SECRET=
# Set this only after migrating the full LMS schema to the target database dialect.
# LECTURESEEK_DATABASE_URL=
# Recommended for fast online transcription and automatic summaries.
GROQ_API_KEY=
# Set to true to forbid cloud (Groq) fallback for Tutor, Mind Map and Resource Finder.
# TUTOR_LOCAL_ONLY=false# Open-source translation fallback after configured LLMs. Base URL, without /translate.
# Self-host LibreTranslate separately; install the required language models.
LIBRETRANSLATE_URL=
# Optional, if your LibreTranslate server requires a key.
LIBRETRANSLATE_API_KEY=
# Last translation fallback: Azure Translator v3 (standard neural translation).
MICROSOFT_TRANSLATOR_KEY=
# Required for regional/multi-service Azure resources; leave empty for global resources.
MICROSOFT_TRANSLATOR_REGION=
# Optional fallback used when Gemini returns a quota, rate-limit, or temporary availability error.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini
# Optional speaker diarization (accept the pyannote model terms on Hugging Face)
HUGGINGFACE_TOKEN=
# Optional: path to a Netscape-format YouTube cookies file for yt-dlp.
# YTDLP_COOKIES_FILE=/content/youtube_cookies.txt